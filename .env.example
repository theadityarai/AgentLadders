# ==============================================================================
# AgentLadders — Production Environment Variables Reference
# ==============================================================================

# 1. Authentication & Security (MANDATORY)
# Generate a strong 32+ character random secret using: openssl rand -base64 32
NEXTAUTH_SECRET="agentladders-secret-production-key-998877665544332211"

# Production canonical domain URL (e.g. https://agentladders.com or https://your-app.vercel.app)
# Note: On Vercel, this is auto-inferred if not set, but setting it explicitly is recommended.
NEXTAUTH_URL="https://agent-ladders.vercel.app"

# 2. Production Cloud Persistence (HIGHLY RECOMMENDED FOR VERCEL / SERVERLESS)
# In serverless environments, local files in /tmp reset between instances.
# Upstash Redis provides persistent, instant cloud data sync with a generous free tier.
# Get free credentials at: https://console.upstash.com (or add Upstash Redis from Vercel Marketplace)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# 3. Node Environment
NODE_ENV="production"
